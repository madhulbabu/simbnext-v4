---
import { CASE_STUDIES } from '@/lib/content';
---

<section class="py-24 md:py-32 bg-[#F8FAFC] border-b border-[#E2E8F0] relative overflow-hidden">
  <!-- Subtle ambient radial cobalt light -->
  <div class="pointer-events-none absolute top-10 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gradient-to-b from-[#1B17FF]/6 via-[#1B17FF]/3 to-transparent rounded-full blur-[100px]" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>Verified Outcomes</span>
      </div>
      <h2 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        Scale, convert, and operate with discipline.
      </h2>
      <p class="mt-4 body-lg text-[#334155] [text-wrap:balance]">
        Real outcomes delivered for owner-led businesses who traded fragmented agency chaos for an accountable digital department.
      </p>
    </div>

    <!-- 4 Customer Cards -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {CASE_STUDIES.map((c) => (
        <div class="card-synthesia p-7 flex flex-col justify-between hover:scale-[1.01] transition-transform">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-[11px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#EEF2FF] text-[#1B17FF] border border-[#E0E7FF]">
                {c.sector}
              </span>
              <div class="flex text-amber-400 text-xs">
                ★★★★★
              </div>
            </div>

            <div class="my-4 p-4 rounded-2xl bg-[#EEF2FF] border border-[#E0E7FF]">
              <div class="text-3xl font-extrabold text-[#1B17FF] font-mono tracking-tight">
                {c.stat}
              </div>
              <div class="text-xs font-mono font-bold mt-1 text-[#1B17FF]">
                {c.statLabel}
              </div>
            </div>

            <p class="text-sm text-[#334155] leading-relaxed italic">
              "{c.quote}"
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
            <div class="text-sm font-bold text-[#0F172A] flex items-center justify-between">
              <span>{c.author}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#1B17FF]">
                <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div class="text-xs text-[#64748B] mt-0.5">
              {c.role}
            </div>
            <div class="text-[11px] font-mono text-[#64748B] mt-1">
              {c.client} • {c.location}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Case Studies Link -->
    <div class="mt-14 text-center">
      <a href="/case-studies" class="button-secondary">
        <span>View Detailed Case Studies</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
