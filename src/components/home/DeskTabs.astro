---
import { DESKS } from '@/lib/content';
---

<section id="desks" class="py-24 md:py-32 bg-[#FFFFFF] border-b border-[#E2E8F0]">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-14">
      <div class="chip-synthesia mb-4">
        <span>Functional Architecture</span>
      </div>
      <h2 class="headline-lg text-[#0F172A]">
        Six specialized Desks.<br class="hidden sm:inline" /> Zero operational gaps.
      </h2>
      <p class="mt-4 body-lg text-[#334155]">
        You don’t buy fragmented agency hours. You subscribe to dedicated accountability for recurring digital functions, governed by clear Service Level Agreements.
      </p>
    </div>

    <!-- Interactive Desk Tabs Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 p-2 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] mb-10">
      {DESKS.map((desk, idx) => (
        <button
          type="button"
          data-desk-target={desk.id}
          class:list={[
            "desk-tab-btn py-3 px-3.5 rounded-xl text-left transition-all duration-200 cursor-pointer flex flex-col justify-between border",
            idx === 0
              ? "bg-white text-[#0F172A] shadow-md border-[#E2E8F0] ring-2 ring-[#1B17FF]"
              : "text-[#334155] border-transparent hover:text-[#1B17FF] hover:bg-[#EEF2FF] hover:border-[#E0E7FF]"
          ]}
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-[#1B17FF]">{desk.index}</span>
            <span class:list={[
              "desk-indicator h-2 w-2 rounded-full",
              idx === 0 ? "bg-[#1B17FF]" : "bg-transparent"
            ]}></span>
          </div>
          <div class="text-sm font-bold truncate">{desk.name}</div>
          <div class="text-[11px] text-[#64748B] truncate mt-0.5">{desk.category}</div>
        </button>
      ))}
    </div>

    <!-- Active Tab Content Panes -->
    <div class="relative min-h-[440px]">
      {DESKS.map((desk, idx) => (
        <div
          id={`desk-content-${desk.id}`}
          class:list={[
            "desk-pane card-synthesia transition-all duration-300",
            idx === 0 ? "block" : "hidden"
          ]}
        >
          <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 items-start">
            
            <!-- Left Sub-column: Scope, Tagline & SLA -->
            <div>
              <div class="flex items-center gap-3 mb-4">
                <span class="chip-synthesia">{desk.category}</span>
                <span class="text-xs font-mono text-[#64748B]">Desk {desk.index} of 06</span>
              </div>

              <h3 class="headline-md text-[#0F172A] mt-1">
                {desk.name}
              </h3>
              
              <p class="mt-2 text-base font-medium text-[#1B17FF]">
                {desk.tagline}
              </p>

              <p class="mt-4 body-md text-[#334155] leading-relaxed">
                {desk.description}
              </p>

              <!-- SLA Guarantee Box (Ice Blue Tint) -->
              <div class="mt-7 rounded-2xl bg-[#EEF2FF] p-5 border border-[#E0E7FF]">
                <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#1B17FF] uppercase tracking-wider mb-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  Service Level Agreement (SLA)
                </div>
                <p class="text-sm font-semibold text-[#0F172A]">
                  {desk.sla}
                </p>
              </div>

              <!-- View Specifications Link -->
              <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
                <a
                  href={`/services/${desk.slug}`}
                  class="inline-flex items-center gap-2 text-sm font-bold text-[#1B17FF] hover:underline group"
                >
                  <span>View full {desk.name} scope & specifications</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1">
                    <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Right Sub-column: Scope Deliverables & Focus Areas -->
            <div class="space-y-6">
              
              <div>
                <h4 class="text-xs font-mono font-bold text-[#0F172A] uppercase tracking-wider mb-3">
                  Scope & Deliverables
                </h4>
                <ul class="grid gap-2.5">
                  {desk.deliverables.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm text-[#334155] bg-[#F8FAFC] p-3 rounded-xl border border-[#E2E8F0]">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#1B17FF] mt-0.5 shrink-0">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h4 class="text-xs font-mono font-bold text-[#0F172A] uppercase tracking-wider mb-3">
                  Strategic Outcomes
                </h4>
                <div class="space-y-2">
                  {desk.outcomes.map((outcome) => (
                    <div class="flex items-center gap-2 text-xs font-semibold text-[#0F172A] bg-[#FFFFFF] p-2.5 rounded-lg border border-[#E2E8F0]">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <span>{outcome}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Fast Routine Example -->
              <div class="p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
                <span class="text-[11px] font-mono uppercase tracking-wider text-[#64748B] block mb-1">Standard Routine</span>
                <p class="text-xs font-medium text-[#334155] leading-relaxed">
                  Every request for this desk is triaged within 2 hours, logged on your dashboard, and deployed with automated regression testing.
                </p>
              </div>

            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function setupDeskTabs() {
    const tabButtons = document.querySelectorAll('.desk-tab-btn');
    const panes = document.querySelectorAll('.desk-pane');

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-desk-target');

        tabButtons.forEach((btn) => {
          btn.classList.remove('bg-white', 'text-[#0F172A]', 'shadow-md', 'border-[#E2E8F0]', 'ring-2', 'ring-[#1B17FF]');
          btn.classList.add('text-[#334155]', 'border-transparent', 'hover:text-[#1B17FF]', 'hover:bg-[#EEF2FF]', 'hover:border-[#E0E7FF]');
          const indicator = btn.querySelector('.desk-indicator');
          indicator?.classList.remove('bg-[#1B17FF]');
          indicator?.classList.add('bg-transparent');
        });

        button.classList.add('bg-white', 'text-[#0F172A]', 'shadow-md', 'border-[#E2E8F0]', 'ring-2', 'ring-[#1B17FF]');
        button.classList.remove('text-[#334155]', 'border-transparent', 'hover:text-[#1B17FF]', 'hover:bg-[#EEF2FF]', 'hover:border-[#E0E7FF]');
        const activeIndicator = button.querySelector('.desk-indicator');
        activeIndicator?.classList.add('bg-[#1B17FF]');
        activeIndicator?.classList.remove('bg-transparent');

        panes.forEach((pane) => {
          pane.classList.add('hidden');
          pane.classList.remove('block');
        });

        const activePane = document.getElementById(`desk-content-${targetId}`);
        if (activePane) {
          activePane.classList.remove('hidden');
          activePane.classList.add('block');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupDeskTabs);
  setupDeskTabs();
</script>
