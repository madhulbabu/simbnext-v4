---
import { FAQS } from '@/lib/content';
---

<section id="faq" class="py-24 md:py-32 bg-[#FFFFFF] border-b border-[#E2E8F0]">
  <div class="container-tight max-w-3xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>Frequently Answered</span>
      </div>
      <h2 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        Everything you need to know.
      </h2>
      <p class="mt-4 body-lg text-[#334155] [text-wrap:balance]">
        Transparent answers about our engagement models, SLAs, and operating standards.
      </p>
    </div>

    <!-- Accordion Items (Native HTML5 Details for 100% Zero-Failure Reliability) -->
    <div class="space-y-4">
      {FAQS.map((faq, idx) => (
        <details
          class="faq-item group rounded-2xl border border-[#E2E8F0] bg-[#F8FAFC] overflow-hidden transition-all duration-200 open:bg-white open:border-[#1B17FF]/40 open:shadow-xs"
          open={idx === 0}
        >
          <summary class="w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 font-bold text-[#0F172A] group-open:text-[#1B17FF] hover:text-[#1B17FF] transition-colors cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden">
            <span class="text-base sm:text-lg pr-2">{faq.q}</span>
            <span class="h-8 w-8 rounded-full bg-white border border-[#E2E8F0] group-open:border-[#1B17FF] group-open:bg-[#EEF2FF] flex items-center justify-center text-[#1B17FF] shrink-0 transition-transform duration-300 group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </span>
          </summary>
          <div class="px-5 sm:px-6 pb-6 text-sm sm:text-base text-[#64748B] leading-relaxed border-t border-[#E2E8F0]/60 pt-4">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
