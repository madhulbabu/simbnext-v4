---
// HeroBackup Component
---

<section class="relative overflow-hidden bg-gradient-to-b from-[#EFF6FF] via-[#F8FAFC] to-white text-[#0F172A] pt-36 md:pt-44 pb-20 md:pb-28 border-b border-[#E2E8F0]">
  <!-- Soft ambient radial cobalt glow -->
  <div class="pointer-events-none absolute top-10 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-[#1B17FF]/10 via-[#1B17FF]/4 to-transparent rounded-full blur-[120px]" aria-hidden="true"></div>

  <div class="container-wide relative z-10 text-center">
    
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-white text-[#1B17FF] border border-[#DBEAFE] shadow-xs mb-6">
      <span class="h-2 w-2 rounded-full bg-[#10B981] animate-pulse"></span>
      <span>Digital Operations Command Center · 90-Day Comfort Guarantee</span>
    </div>

    <!-- Centered Headline -->
    <h1 class="headline-display text-[#0F172A] max-w-4xl mx-auto tracking-tight [text-wrap:balance]">
      Your Digital Operations.
      <span class="inline-block bg-[#EFF6FF] text-[#1B17FF] px-4 py-1 rounded-2xl border border-[#DBEAFE] mx-1 shadow-xs">
        Handled.
      </span>
    </h1>

    <!-- Centered Subheadline (Exact Core Promise) -->
    <p class="body-lg text-[#334155] max-w-2xl mx-auto mt-6 leading-relaxed [text-wrap:balance]">
      You will never lose sleep over your digital operations again. We run your brand, web presence, growth, systems, custom tech, and AI intelligence through a single command center.
    </p>

    <!-- Trust Strip -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5 text-xs text-[#64748B] font-mono">
      <span class="font-bold text-[#0F172A]">6 Desks</span>
      <span>•</span>
      <span>1 Dedicated Ops Lead</span>
      <span>•</span>
      <span>Weekly Monday Briefings</span>
      <span>•</span>
      <span class="text-[#1B17FF] font-bold">90-Day Comfort Guarantee</span>
    </div>

    <!-- Centered CTA Buttons -->
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4 min-h-[48px]">
      <a href="/briefing" class="button-primary text-center">
        <span>Schedule a Briefing</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
      <a href="#desks" class="button-secondary text-center">
        <span>Explore The 6 Desks ↓</span>
      </a>
    </div>

    <!-- Centered Hero Visual Dashboard Frame -->
    <div class="mt-14 max-w-5xl mx-auto">
      <div class="relative rounded-3xl border border-[#E2E8F0] bg-white p-3 sm:p-5 shadow-[0_20px_60px_rgba(27,23,255,0.06)] overflow-hidden">
        
        <!-- Browser / Command Top Header Bar -->
        <div class="flex items-center justify-between px-3 py-2.5 bg-[#F8FAFC] rounded-2xl border border-[#E2E8F0] mb-4">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <span class="h-3 w-3 rounded-full bg-[#1B17FF]"></span>
              <span class="h-3 w-3 rounded-full bg-amber-400"></span>
              <span class="h-3 w-3 rounded-full bg-[#10B981]"></span>
            </div>
            <span class="text-xs font-mono text-[#64748B] ml-2 hidden sm:inline">simbnext.com/command-center</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#10B981] animate-pulse"></span>
            <span class="text-[11px] font-mono font-bold text-[#1B17FF] bg-[#EFF6FF] px-2.5 py-0.5 rounded-full border border-[#DBEAFE]">
              6 Desks Synchronized · Zero Vendor Chaos
            </span>
          </div>
        </div>

        <!-- 6-Desk Interactive Preview Grid inside Dashboard -->
        <div class="grid gap-3 sm:grid-cols-3 text-left">
          
          <!-- Desk 1: Brand Desk -->
          <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] hover:border-[#1B17FF]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1B17FF]">01 · Brand Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#EFF6FF] text-[#1B17FF] font-bold">Design & Voice</span>
            </div>
            <div class="text-sm font-bold text-[#0F172A]">Identity & Guidelines</div>
            <p class="text-xs text-[#64748B] mt-1">Never feel inconsistent or outdated again</p>
            <div class="mt-3 pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
              <span class="text-[#64748B]">Coverage</span>
              <span class="text-[#1B17FF] font-bold">100% Cohesive</span>
            </div>
          </div>

          <!-- Desk 2: Presence Desk -->
          <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] hover:border-[#1B17FF]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1B17FF]">02 · Presence Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#EFF6FF] text-[#1B17FF] font-bold">Web & SEO</span>
            </div>
            <div class="text-sm font-bold text-[#0F172A]">Website & Search</div>
            <p class="text-xs text-[#64748B] mt-1">Always findable, credible, and current online</p>
            <div class="mt-3 pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
              <span class="text-[#64748B]">Uptime</span>
              <span class="text-[#1B17FF] font-bold">99.8% SLA</span>
            </div>
          </div>

          <!-- Desk 3: Growth Desk -->
          <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] hover:border-[#1B17FF]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1B17FF]">03 · Growth Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#EFF6FF] text-[#1B17FF] font-bold">Acquisition</span>
            </div>
            <div class="text-sm font-bold text-[#0F172A]">Ads & Funnels</div>
            <p class="text-xs text-[#64748B] mt-1">Qualified prospects consistently finding your door</p>
            <div class="mt-3 pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
              <span class="text-[#64748B]">Pipeline</span>
              <span class="text-emerald-700 font-bold">Always Flowing</span>
            </div>
          </div>

          <!-- Desk 4: Systems Desk -->
          <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] hover:border-[#1B17FF]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1B17FF]">04 · Systems Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold">Irreplaceable</span>
            </div>
            <div class="text-sm font-bold text-[#0F172A]">CRM & Automations</div>
            <p class="text-xs text-[#64748B] mt-1">Runs like clockwork with or without you</p>
            <div class="mt-3 pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
              <span class="text-[#64748B]">Time Saved</span>
              <span class="text-emerald-700 font-bold">40+ hrs/mo</span>
            </div>
          </div>

          <!-- Desk 5: Build Desk -->
          <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] hover:border-[#1B17FF]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1B17FF]">05 · Build Desk</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold">Custom Tech</span>
            </div>
            <div class="text-sm font-bold text-[#0F172A]">Custom Portals & Apps</div>
            <p class="text-xs text-[#64748B] mt-1">Built fast, right, and integrated with everything</p>
            <div class="mt-3 pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
              <span class="text-[#64748B]">Velocity</span>
              <span class="text-blue-800 font-bold">Rapid Sprints</span>
            </div>
          </div>

          <!-- Desk 6: AI & Intel Desk -->
          <div class="p-4 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] hover:border-[#1B17FF]/40 transition-colors">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-[#1B17FF]">06 · AI & Intel</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-[#EFF6FF] text-[#1B17FF] font-bold">Intelligence</span>
            </div>
            <div class="text-sm font-bold text-[#0F172A]">AI Chatbots & Intel</div>
            <p class="text-xs text-[#64748B] mt-1">Always know what's working and what to do next</p>
            <div class="mt-3 pt-2 border-t border-[#E2E8F0] flex items-center justify-between text-xs font-mono">
              <span class="text-[#64748B]">Speed</span>
              <span class="text-[#1B17FF] font-bold">3.2s AI Triage</span>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
