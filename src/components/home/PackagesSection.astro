---
import { PACKAGES } from '@/lib/content';
---

<section id="packages" class="py-24 md:py-32 bg-[#FFFFFF] border-b border-[#E2E8F0]">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>Coverage-Based Retainers</span>
      </div>
      <h2 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        Coverage-based retainers.<br class="hidden sm:inline" /> Zero per-hour billing.
      </h2>
      <p class="mt-4 body-lg text-[#334155] [text-wrap:balance]">
        You don't buy fragmented agency hours. You get dedicated operational coverage across your active desks, directed by your Ops Lead and backed by our 90-Day Comfort Guarantee.
      </p>
    </div>

    <!-- 3 Tier Cards -->
    <div class="grid gap-8 lg:grid-cols-3 items-stretch">
      {PACKAGES.map((pkg) => (
        pkg.featured ? (
          <div class="relative rounded-3xl bg-[#0B0F19] text-[#F1F5F9] p-7 xl:p-9 shadow-2xl flex flex-col justify-between border-2 border-[#1B17FF] hover:scale-[1.01] transition-transform">
            <div class="absolute -top-3.5 right-6">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#1B17FF] px-3.5 py-1 text-xs font-mono font-bold uppercase tracking-wider text-white shadow-md">
                {pkg.badge}
              </span>
            </div>

            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-[#60A5FA] font-bold">
                {pkg.tier}
              </span>
              <h3 class="headline-md text-white mt-1">
                {pkg.name}
              </h3>
              
              <div class="mt-3 inline-flex items-center gap-2 text-xs font-bold text-[#F1F5F9] bg-white/10 px-3 py-1 rounded-full border border-white/15">
                <span>{pkg.desksIncluded}</span>
              </div>

              <p class="mt-4 text-sm text-[#F1F5F9]/80 leading-relaxed">
                {pkg.recommendedFor}
              </p>

              <div class="my-6 border-t border-white/15"></div>

              <div class="space-y-3">
                <div class="text-xs font-mono uppercase tracking-wider text-[#60A5FA] font-bold">
                  Included Coverage:
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-[#F1F5F9]">
                  {pkg.highlights.map((h) => (
                    <li class="flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#60A5FA] mt-0.5 shrink-0">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-white/15">
              <a href="/briefing" class="btn-white-pill w-full text-center">
                <span>{pkg.ctaText}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        ) : (
          <div class="card-synthesia p-7 xl:p-9 flex flex-col justify-between">
            <div>
              <span class="label-sm text-[#1B17FF]">
                {pkg.tier}
              </span>
              <h3 class="headline-md text-[#0F172A] mt-1">
                {pkg.name}
              </h3>

              <div class="mt-3 inline-flex items-center gap-2 text-xs font-bold text-[#1B17FF] bg-[#EFF6FF] px-3 py-1 rounded-full border border-[#DBEAFE]">
                <span>{pkg.desksIncluded}</span>
              </div>

              <p class="mt-4 text-sm text-[#64748B] leading-relaxed">
                {pkg.recommendedFor}
              </p>

              <div class="my-6 border-t border-[#E2E8F0]"></div>

              <div class="space-y-3">
                <div class="label-sm text-[#64748B]">
                  Included Coverage:
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-[#334155]">
                  {pkg.highlights.map((h) => (
                    <li class="flex items-start gap-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#1B17FF] mt-0.5 shrink-0">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-[#E2E8F0]">
              <a href="/briefing" class="button-primary w-full text-center">
                <span>{pkg.ctaText}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        )
      ))}
    </div>

  </div>
</section>
