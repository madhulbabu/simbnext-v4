---
import { PROCESS } from '@/lib/content';
---

<section class="py-24 md:py-32 bg-[#F8FAFC] border-b border-[#E2E8F0]">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>The 4-Stage Rollout</span>
      </div>
      <h2 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        From chaos to command in four precise stages.
      </h2>
      <p class="mt-4 body-lg text-[#334155] [text-wrap:balance]">
        A structured onboarding flow designed to audit bottlenecks, deploy missing infrastructure, and transition to steady-state operational peace.
      </p>
    </div>

    <!-- 4-Step Cards -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {PROCESS.map((p) => (
        <div class="card-synthesia p-6 flex flex-col justify-between hover:scale-[1.01] transition-transform">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-2xl font-extrabold font-mono text-[#2563EB]">
                {p.step}
              </span>
              <span class="chip-synthesia">Stage {p.step}</span>
            </div>

            <h3 class="headline-sm text-[#0F172A]">
              {p.title}
            </h3>

            <p class="mt-3 text-xs sm:text-sm text-[#64748B] leading-relaxed">
              {p.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E2E8F0]">
            <div class="label-sm text-[#64748B] mb-2">
              Deliverables:
            </div>
            <ul class="space-y-1.5 text-xs text-[#0F172A] font-medium">
              {p.deliverables.map((d) => (
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB] mt-0.5 shrink-0">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Operating Model Link -->
    <div class="mt-12 text-center">
      <a href="/method" class="inline-flex items-center gap-2 text-sm font-bold text-[#2563EB] hover:underline">
        <span>Explore our complete methodology and weekly cadence</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
