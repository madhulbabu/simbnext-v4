---
import { WHY_CHOOSE } from '@/lib/content';
---

<section class="py-24 md:py-32 bg-[#F8FAFC] border-b border-[#E2E8F0]">
  <div class="container-wide">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="chip-synthesia mb-4">
        <span>The Core Philosophy</span>
      </div>
      <h2 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        Operational peace of mind.<br class="hidden sm:inline" /> Not empty hype.
      </h2>
      <p class="mt-4 body-lg text-[#334155] [text-wrap:balance]">
        We don't make reckless growth promises. We make the operational chaos stop. Like your chartered accountant handling your taxes—it's handled.
      </p>
    </div>

    <!-- 6-Card Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {WHY_CHOOSE.map((item, idx) => (
        <div class="card-synthesia p-7 flex flex-col justify-between hover:scale-[1.01] transition-transform">
          <div>
            <div class="h-12 w-12 rounded-2xl bg-[#EFF6FF] text-[#1B17FF] flex items-center justify-center font-mono font-bold text-lg mb-5 border border-[#DBEAFE]">
              0{idx + 1}
            </div>
            <h3 class="headline-sm text-[#0F172A]">
              {item.title}
            </h3>
            <p class="mt-2.5 body-md text-[#64748B] leading-relaxed">
              {item.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#E2E8F0] flex items-center gap-2 text-xs font-mono text-[#1B17FF] font-semibold">
            <span>SLA Governed</span>
            <span class="text-[#E2E8F0]">•</span>
            <span>90-Day Guarantee</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Centered Action -->
    <div class="mt-14 text-center">
      <a href="/briefing" class="button-primary">
        <span>Schedule a Briefing</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
