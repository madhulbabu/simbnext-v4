---
import { SITE } from '@/lib/site-config';

const whatsappMessage = encodeURIComponent(
  "Hi SIMBNEXT, I would like to learn more about your Digital Operations Command Center and schedule an executive briefing."
);
---

<!-- Floating Action Buttons (WhatsApp & Phone) -->
<aside
  id="floating-contact"
  class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3 pointer-events-auto select-none"
  aria-label="Quick contact actions"
>
  <!-- 1. Phone Call Floating Button -->
  <div class="relative group/phone flex items-center">
    <span
      class="hidden md:block absolute right-full mr-3 px-3 py-1.5 rounded-xl bg-[#0B0F19] text-[#F1F5F9] text-xs font-mono font-semibold whitespace-nowrap shadow-xl border border-white/10 opacity-0 -translate-x-2 pointer-events-none group-hover/phone:opacity-100 group-hover/phone:translate-x-0 transition-all duration-200"
    >
      Call {SITE.phone}
    </span>
    <a
      href={`tel:${SITE.phone}`}
      class="h-12 w-12 rounded-full bg-[#2563EB] text-white flex items-center justify-center shadow-xl border border-white/20 hover:bg-[#1D4ED8] hover:scale-110 active:scale-95 transition-all duration-200 cursor-pointer"
      aria-label={`Call SIMBNEXT at ${SITE.phone}`}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
    </a>
  </div>

  <!-- 2. WhatsApp Floating Button with Live Pulse & Tooltip -->
  <div class="relative group/wa flex items-center">
    <span
      class="hidden md:block absolute right-full mr-3 px-3 py-1.5 rounded-xl bg-[#0B0F19] text-[#F1F5F9] text-xs font-mono font-semibold whitespace-nowrap shadow-xl border border-white/10 opacity-0 -translate-x-2 pointer-events-none group-hover/wa:opacity-100 group-hover/wa:translate-x-0 transition-all duration-200"
    >
      💬 Chat on WhatsApp · Live Triage
    </span>
    
    <a
      href={`https://wa.me/${SITE.phoneRaw}?text=${whatsappMessage}`}
      target="_blank"
      rel="noopener noreferrer"
      class="relative h-14 w-14 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white flex items-center justify-center shadow-xl hover:scale-110 active:scale-95 transition-all duration-200 cursor-pointer"
      aria-label="Chat with SIMBNEXT on WhatsApp"
    >
      <!-- Live Online Indicator Pulse -->
      <span class="absolute -top-0.5 -right-0.5 flex h-3.5 w-3.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-[#10B981] border-2 border-white"></span>
      </span>

      <!-- Official WhatsApp SVG Icon -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M17.472 14.382c-.301-.15-1.782-.879-2.058-.98-.276-.1-.477-.15-.678.15-.201.3-.778.98-.954 1.18-.175.2-.351.226-.652.075s-1.272-.469-2.423-1.496c-.896-.799-1.501-1.786-1.677-2.087-.175-.3-.019-.463.132-.613.136-.134.301-.351.451-.527.151-.175.201-.3.301-.501.101-.2.05-.376-.025-.526-.075-.15-.678-1.634-.929-2.238-.244-.588-.492-.508-.678-.518-.175-.009-.376-.011-.577-.011s-.527.075-.803.376c-.276.3-1.054 1.03-1.054 2.511 0 1.482 1.079 2.911 1.23 3.112.151.2 2.124 3.243 5.145 4.549.718.311 1.279.497 1.716.636.721.23 1.377.197 1.896.12.577-.087 1.782-.728 2.033-1.431.251-.703.251-1.305.175-1.431-.075-.126-.276-.201-.577-.351zM12.042 21.684c-1.74 0-3.447-.464-4.945-1.344l-.354-.21-3.676.964.981-3.582-.23-.367a9.66 9.66 0 0 1-1.48-5.184c0-5.348 4.351-9.7 9.704-9.7 2.59 0 5.025 1.009 6.855 2.84 1.83 1.831 2.838 4.267 2.838 6.857 0 5.349-4.351 9.702-9.693 9.716zM12.042 0C5.397 0 0 5.397 0 12.042c0 2.12.553 4.19 1.603 6.009L0 24l6.108-1.602a12.01 12.01 0 0 0 5.934 1.564h.005c6.643 0 12.04-5.399 12.04-12.043 0-3.218-1.253-6.243-3.528-8.518C18.283 1.254 15.259 0 12.042 0z"/>
      </svg>
    </a>
  </div>
</aside>
