---
import { FOOTER_LINKS, SITE } from '@/lib/site-config';
---

<footer class="bg-[#0B0F19] text-[#F1F5F9] pt-20 pb-12 border-t border-white/10">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-5 pb-16 border-b border-white/10">
      
      <!-- Brand & Mission Column (Clean & Uncluttered) -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-flex items-center gap-2">
          <img src="/simbnext-logo-dark.svg" alt="SIMBNEXT" width="145" height="28" class="h-6 sm:h-7 w-auto object-contain" />
        </a>
        <p class="text-[#F1F5F9]/85 text-sm max-w-sm leading-relaxed">
          {SITE.tagline}. We manage all your recurring digital operations under guaranteed monthly SLAs with zero agency chaos.
        </p>

        <!-- Registered Office Address -->
        <div class="pt-2 text-xs text-[#94A3B8] space-y-1">
          <div class="font-bold text-[#F1F5F9]/90 font-sans text-[11px] uppercase tracking-wider">
            📍 Registered Office
          </div>
          <div class="text-[12px] text-[#94A3B8] leading-relaxed">
            <span class="text-white font-medium">{SITE.legalName}</span><br />
            {SITE.address.line1}<br />
            {SITE.address.line2}, {SITE.address.country}
          </div>
        </div>
      </div>

      <!-- Column 1: Company -->
      <div>
        <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-[#F1F5F9]/80 mb-4">
          Company
        </h3>
        <ul class="space-y-2.5 text-sm">
          {FOOTER_LINKS.Company.map((link) => (
            <li>
              <a href={link.href} class="text-[#F1F5F9]/85 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 2: The 6 Desks -->
      <div>
        <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-[#F1F5F9]/80 mb-4">
          The 6 Desks
        </h3>
        <ul class="space-y-2.5 text-sm">
          {FOOTER_LINKS.Desks.map((link) => (
            <li>
              <a href={link.href} class="text-[#F1F5F9]/85 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Legal & Guarantee + Connect (Second Half) -->
      <div class="flex flex-col justify-between">
        <div>
          <h3 class="text-xs font-sans font-bold uppercase tracking-wider text-[#F1F5F9]/80 mb-4">
            Legal & Guarantee
          </h3>
          <ul class="space-y-2.5 text-sm">
            {FOOTER_LINKS.Legal.map((link) => (
              <li>
                <a href={link.href} class="text-[#F1F5F9]/80 hover:text-white transition-colors text-xs">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Second Half: Connect / Social Media Icons -->
        <div class="pt-6 mt-6 border-t border-white/10">
          <h4 class="text-xs font-sans font-bold uppercase tracking-wider text-[#F1F5F9]/80 mb-3">
            Connect
          </h4>
          <div class="flex items-center gap-2.5 text-[#F1F5F9]/80">
            <!-- LinkedIn -->
            <a
              href="https://linkedin.com/company/simbnext"
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-[4px] bg-white/5 border border-white/10 flex items-center justify-center text-[#F1F5F9]/80 hover:text-white hover:bg-white/15 hover:border-white/20 transition-all"
              aria-label="SIMBNEXT on LinkedIn"
              title="LinkedIn"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </a>

            <!-- X (Twitter) -->
            <a
              href="https://x.com/simbnext"
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-[4px] bg-white/5 border border-white/10 flex items-center justify-center text-[#F1F5F9]/80 hover:text-white hover:bg-white/15 hover:border-white/20 transition-all"
              aria-label="SIMBNEXT on X"
              title="X (Twitter)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href="https://youtube.com/@simbnext"
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-[4px] bg-white/5 border border-white/10 flex items-center justify-center text-[#F1F5F9]/80 hover:text-white hover:bg-white/15 hover:border-white/20 transition-all"
              aria-label="SIMBNEXT on YouTube"
              title="YouTube"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="https://instagram.com/simbnext"
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 rounded-[4px] bg-white/5 border border-white/10 flex items-center justify-center text-[#F1F5F9]/80 hover:text-white hover:bg-white/15 hover:border-white/20 transition-all"
              aria-label="SIMBNEXT on Instagram"
              title="Instagram"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#F1F5F9]/80">
      <div>
        &copy; {new Date().getFullYear()} {SITE.legalName}. All rights reserved. Operating under strict Service Level Agreements.
      </div>
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-2 text-[#10B981] font-sans">
          <span class="h-2 w-2 rounded-full bg-[#10B981] animate-pulse"></span>
          All Desks Operational (99.8% SLA)
        </span>
      </div>
    </div>
  </div>
</footer>
