---
import { NAV_LINKS, SITE } from '@/lib/site-config';
---

<!-- Mobile Drawer Backdrop -->
<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
>
</div>

<!-- Mobile Drawer Content -->
<div
  id="mobile-menu-drawer"
  class="fixed top-0 right-0 bottom-0 w-[85%] max-w-sm bg-white text-[#0F172A] z-[70] shadow-2xl p-6 flex flex-col justify-between translate-x-full transition-transform duration-300 ease-out lg:hidden overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
>
  <div>
    <!-- Header with Logo and Close Button -->
    <div class="flex items-center justify-between pb-5 border-b border-[#E2E8F0]">
      <a href="/" class="mobile-nav-link inline-flex items-center gap-2" aria-label="SIMBNEXT Home">
        <img src="/simbnext-logo.svg" alt="SIMBNEXT" width="135" height="26" class="h-6 w-auto object-contain" />
      </a>
      <button
        id="mobile-menu-close"
        type="button"
        class="h-9 w-9 rounded-[4px] bg-[#F8FAFC] border border-[#E2E8F0] flex items-center justify-center text-[#0F172A] hover:bg-[#EFF6FF] hover:text-[#2563EB] transition-colors cursor-pointer"
        aria-label="Close navigation menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="mt-6 flex flex-col gap-1">
      {NAV_LINKS.map((link) => (
        link.children ? (
          <div class="py-2 border-b border-[#E2E8F0]">
            <div class="px-2 py-1 text-xs font-semibold uppercase tracking-wider text-[#2563EB]">
              {link.label}
            </div>
            <div class="mt-1 pl-2 space-y-1">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="mobile-nav-link block px-3 py-2 rounded-[4px] text-sm text-[#334155] hover:bg-[#EFF6FF] hover:text-[#2563EB] transition-colors"
                >
                  <div class="font-semibold">{child.label}</div>
                  <div class="text-[11px] text-[#64748B]">{child.description}</div>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="mobile-nav-link px-3 py-2.5 rounded-[4px] text-base font-semibold text-[#0F172A] hover:bg-[#EFF6FF] hover:text-[#2563EB] transition-colors"
          >
            {link.label}
          </a>
        )
      ))}
    </nav>
  </div>

  <!-- Bottom CTA & Contact in Mobile Drawer -->
  <div class="pt-6 border-t border-[#E2E8F0] space-y-3">
    <a
      href="/briefing"
      class="mobile-nav-link button-primary w-full text-center"
    >
      <span>Schedule a Briefing</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>

    <div class="flex items-center justify-center gap-4 pt-2 text-xs font-medium text-[#64748B]">
      <a href={`tel:${SITE.phone.replace(/\s+/g, '')}`} class="hover:text-[#2563EB] flex items-center gap-1.5 font-mono">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2563EB]">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>{SITE.phone}</span>
      </a>
      <span>·</span>
      <a href={`https://wa.me/${SITE.phoneRaw}`} target="_blank" rel="noopener noreferrer" class="text-emerald-600 hover:underline">
        WhatsApp
      </a>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const drawer = document.getElementById('mobile-menu-drawer');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!openBtn || !closeBtn || !backdrop || !drawer) return;

    function openMenu() {
      if (!drawer || !backdrop || !openBtn) return;
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      openBtn.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      if (!drawer || !backdrop || !openBtn) return;
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      openBtn.setAttribute('aria-expanded', 'false');
    }

    openBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openMenu();
    });

    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  }

  // Initialize on regular DOM load and on Astro view transition page changes
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
