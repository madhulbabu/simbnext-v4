---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | SIMBNEXT"
  description="The page you are looking for does not exist or has been moved."
>
  <main class="min-h-[70vh] flex items-center justify-center py-24 bg-[#FFFFFF]">
    <div class="container-tight text-center space-y-6">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#EFF6FF] px-4 py-1.5 text-xs font-mono font-bold uppercase tracking-wider text-[#1B17FF] border border-[#DBEAFE]">
        <span class="h-2 w-2 rounded-full bg-red-500"></span>
        404 · Route Not Found
      </span>

      <h1 class="headline-lg text-[#0F172A]">
        Lost in the Command Center?
      </h1>

      <p class="body-lg text-[#334155] max-w-lg mx-auto">
        The requested URL does not match any active desk route or briefing page. Return to the main command center.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="button-primary">
          <span>Return to Command Center</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
        </a>

        <a href="/briefing" class="button-secondary">
          <span>Schedule a Briefing</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
