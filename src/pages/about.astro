---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="About & Philosophy | SIMBNEXT"
  description="SIMBNEXT was built on two decades of corporate systems execution. We replace fragmented agencies with one unified operations command center."
>
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#EFF6FF] via-[#F8FAFC] to-white text-[#0F172A] border-b border-[#E2E8F0]">
    <div class="container-wide max-w-3xl space-y-4 text-center mx-auto">
      <span class="chip-synthesia">Leadership & Philosophy</span>
      <h1 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        Two Decades of Systems Rigor
      </h1>
      <p class="body-lg text-[#334155] [text-wrap:balance]">
        We built SIMBNEXT because business owners are exhausted by babysitting junior agencies, fragmented freelancers, and endless finger-pointing.
      </p>
    </div>
  </div>

  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide max-w-4xl space-y-12">
      <!-- Founder Philosophy Card -->
      <div class="card-synthesia p-8 md:p-12 space-y-6">
        <span class="chip-synthesia">Our Core Thesis</span>
        <h2 class="headline-md text-[#0F172A]">
          Operational relief is the only metric that matters.
        </h2>
        <p class="text-base text-[#334155] leading-relaxed">
          Most agencies promise 10x growth that they cannot control. At SIMBNEXT, our core promise is different: <strong>"You will never lose sleep over your digital operations again."</strong>
        </p>
        <p class="text-base text-[#334155] leading-relaxed">
          We approach digital operations the way a chartered accountant approaches your taxes—<strong>it is handled. You do not need to think about it.</strong> We take full ownership of your Brand, Web Presence, Growth Funnels, Systems Automation, Custom Software, and AI Intelligence under one accountable Command Center.
        </p>
      </div>

      <!-- 3 Tenets -->
      <div class="grid gap-6 md:grid-cols-3">
        <div class="p-6 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] space-y-3">
          <div class="text-xl font-bold font-mono text-[#1B17FF]">01</div>
          <h3 class="text-base font-bold text-[#0F172A]">One Ops Lead</h3>
          <p class="text-xs text-[#64748B] leading-relaxed">
            One senior point of contact who knows your entire business inside and out. Zero junior account managers playing telephone.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] space-y-3">
          <div class="text-xl font-bold font-mono text-[#1B17FF]">02</div>
          <h3 class="text-base font-bold text-[#0F172A]">Live Visibility</h3>
          <p class="text-xs text-[#64748B] leading-relaxed">
            A real-time command dashboard showing what is on track, what needs input, and what is completed across all active desks.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0] space-y-3">
          <div class="text-xl font-bold font-mono text-[#1B17FF]">03</div>
          <h3 class="text-base font-bold text-[#0F172A]">90-Day Guarantee</h3>
          <p class="text-xs text-[#64748B] leading-relaxed">
            If you do not feel your operations are noticeably smoother after 90 days, we offboard you smoothly and refund your last month in full.
          </p>
        </div>
      </div>

      <!-- Direct Contact CTA -->
      <div class="text-center pt-8">
        <a href="/briefing" class="button-primary">
          <span>Schedule a Briefing</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
