---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site-config';

const whatsappMsg = encodeURIComponent(
  "Hi SIMBNEXT, I would like to learn more about your Digital Operations Command Center and schedule an executive briefing."
);
---

<BaseLayout
  title="Schedule a Briefing | SIMBNEXT"
  description="Schedule an operational briefing to discuss your digital infrastructure, vendor bottlenecks, and coverage across our 6 Desks."
>
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#EEF2FF] via-[#F8FAFC] to-white text-[#0F172A] border-b border-[#E2E8F0]">
    <div class="container-wide max-w-3xl space-y-4 text-center mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-sans font-bold uppercase tracking-wider bg-white text-[#1B17FF] border border-[#E0E7FF] shadow-xs">
        <span class="h-2 w-2 rounded-full bg-[#10B981] animate-pulse"></span>
        <span>Direct Partnership</span>
      </div>
      <h1 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        Schedule an Executive Briefing
      </h1>
      <p class="body-lg text-[#334155] [text-wrap:balance]">
        A 30-minute deep-dive session to understand your bottlenecks, audit your existing tools and vendors, and map your new operational architecture.
      </p>
    </div>
  </div>

  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide max-w-5xl">
      <div class="grid gap-12 lg:grid-cols-12 items-start">
        
        <!-- Form Column -->
        <div class="lg:col-span-7 card-synthesia p-8 sm:p-10 space-y-6">
          <div>
            <h2 class="headline-sm text-[#0F172A]">
              Request Your Briefing
            </h2>
            <p class="text-xs text-[#64748B] mt-1">
              Zero sales pressure. We will review your digital footprint before we meet.
            </p>
          </div>

          <form id="audit-form" class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-xs font-sans font-bold uppercase text-[#0F172A] mb-1.5">
                  Your Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Rajesh Rao"
                  class="w-full px-4 py-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] text-sm text-[#0F172A] focus:outline-none focus:ring-2 focus:ring-[#1B17FF]"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-sans font-bold uppercase text-[#0F172A] mb-1.5">
                  Phone / WhatsApp *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] text-sm text-[#0F172A] focus:outline-none focus:ring-2 focus:ring-[#1B17FF]"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-sans font-bold uppercase text-[#0F172A] mb-1.5">
                Work Email Address *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="rajesh@yourcompany.com"
                class="w-full px-4 py-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] text-sm text-[#0F172A] focus:outline-none focus:ring-2 focus:ring-[#1B17FF]"
              />
            </div>

            <div>
              <label for="company" class="block text-xs font-sans font-bold uppercase text-[#0F172A] mb-1.5">
                Company Name & Website *
              </label>
              <input
                type="text"
                id="company"
                name="company"
                required
                placeholder="e.g. Apex Health (apexhealth.com)"
                class="w-full px-4 py-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] text-sm text-[#0F172A] focus:outline-none focus:ring-2 focus:ring-[#1B17FF]"
              />
            </div>

            <div>
              <label for="bottleneck" class="block text-xs font-sans font-bold uppercase text-[#0F172A] mb-1.5">
                What is your biggest operational bottleneck? *
              </label>
              <textarea
                id="bottleneck"
                name="bottleneck"
                rows="3"
                required
                placeholder="e.g. Managing multiple freelancers, slow lead follow-ups, off-brand collateral, manual CRM entry..."
                class="w-full px-4 py-3 rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] text-sm text-[#0F172A] focus:outline-none focus:ring-2 focus:ring-[#1B17FF]"
              ></textarea>
            </div>

            <button type="submit" class="button-primary w-full text-center">
              <span>Request Executive Briefing</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>
          </form>

          <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium text-center">
            ✓ Thank you. We will review your digital operations and reach out within 4 business hours to confirm your briefing.
          </div>
        </div>

        <!-- Sidebar / What to Expect & Direct Actions Column -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-3xl bg-[#EEF2FF] border border-[#E0E7FF] space-y-4">
            <span class="chip-synthesia">What Happens Next?</span>
            <div class="space-y-4 text-xs">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[#1B17FF] text-white flex items-center justify-center font-sans font-bold shrink-0">1</span>
                <div>
                  <div class="font-bold text-[#0F172A]">The Briefing (30 Mins)</div>
                  <div class="text-[#64748B] mt-0.5">We audit your existing vendors, tools, and recurring bottlenecks.</div>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[#1B17FF] text-white flex items-center justify-center font-sans font-bold shrink-0">2</span>
                <div>
                  <div class="font-bold text-[#0F172A]">The Blueprint Presentation</div>
                  <div class="text-[#64748B] mt-0.5">We present your active desk mapping, custom SLAs, and rollout plan.</div>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-[#1B17FF] text-white flex items-center justify-center font-sans font-bold shrink-0">3</span>
                <div>
                  <div class="font-bold text-[#0F172A]">90-Day Comfort Guarantee</div>
                  <div class="text-[#64748B] mt-0.5">100% risk-free. If operations aren't noticeably smoother, full last-month refund.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Direct Line Card with Phone & WhatsApp -->
          <div class="p-6 rounded-3xl bg-[#F8FAFC] border border-[#E2E8F0] space-y-3 text-xs">
            <span class="text-xs font-sans font-bold uppercase text-[#64748B] tracking-wider block">
              Direct Contact
            </span>

            <div class="space-y-2.5">
              <!-- 1. Direct Phone Dial -->
              <a
                href={`tel:${SITE.phone.replace(/\s+/g, '')}`}
                class="p-3 rounded-2xl bg-white border border-[#E2E8F0] hover:border-[#1B17FF] hover:bg-[#EEF2FF] transition-all flex items-center justify-between group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl bg-[#EEF2FF] group-hover:bg-[#1B17FF] group-hover:text-white flex items-center justify-center text-[#1B17FF] transition-colors shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-[11px] text-[#64748B] font-sans">Direct Phone Call</div>
                    <div class="text-xs font-bold font-sans text-[#0F172A] group-hover:text-[#1B17FF]">{SITE.phone}</div>
                  </div>
                </div>
                <span class="text-xs font-sans text-[#1B17FF] font-bold">Call →</span>
              </a>

              <!-- 2. Direct WhatsApp -->
              <a
                href={`https://wa.me/${SITE.phoneRaw}?text=${whatsappMsg}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-2xl bg-white border border-[#E2E8F0] hover:border-emerald-500 hover:bg-emerald-50/50 transition-all flex items-center justify-between group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl bg-emerald-50 group-hover:bg-emerald-600 group-hover:text-white flex items-center justify-center text-emerald-600 transition-colors shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.301-.15-1.782-.879-2.058-.98-.276-.1-.477-.15-.678.15-.201.3-.778.98-.954 1.18-.175.2-.351.226-.652.075s-1.272-.469-2.423-1.496c-.896-.799-1.501-1.786-1.677-2.087-.175-.3-.019-.463.132-.613.136-.134.301-.351.451-.527.151-.175.201-.3.301-.501.101-.2.05-.376-.025-.526-.075-.15-.678-1.634-.929-2.238-.244-.588-.492-.508-.678-.518-.175-.009-.376-.011-.577-.011s-.527.075-.803.376c-.276.3-1.054 1.03-1.054 2.511 0 1.482 1.079 2.911 1.23 3.112.151.2 2.124 3.243 5.145 4.549.718.311 1.279.497 1.716.636.721.23 1.377.197 1.896.12.577-.087 1.782-.728 2.033-1.431.251-.703.251-1.305.175-1.431-.075-.126-.276-.201-.577-.351zM12.042 21.684c-1.74 0-3.447-.464-4.945-1.344l-.354-.21-3.676.964.981-3.582-.23-.367a9.66 9.66 0 0 1-1.48-5.184c0-5.348 4.351-9.7 9.704-9.7 2.59 0 5.025 1.009 6.855 2.84 1.83 1.831 2.838 4.267 2.838 6.857 0 5.349-4.351 9.702-9.693 9.716zM12.042 0C5.397 0 0 5.397 0 12.042c0 2.12.553 4.19 1.603 6.009L0 24l6.108-1.602a12.01 12.01 0 0 0 5.934 1.564h.005c6.643 0 12.04-5.399 12.04-12.043 0-3.218-1.253-6.243-3.528-8.518C18.283 1.254 15.259 0 12.042 0z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-[11px] text-[#64748B] font-sans">WhatsApp Live Triage</div>
                    <div class="text-xs font-bold text-[#0F172A] group-hover:text-emerald-700">Chat Instantly</div>
                  </div>
                </div>
                <span class="text-xs font-sans text-emerald-600 font-bold">Chat →</span>
              </a>
            </div>
          </div>

          <!-- 3. Registered Office Card -->
          <div class="p-6 rounded-3xl bg-[#FFFFFF] border border-[#E2E8F0] space-y-2 text-xs">
            <span class="text-xs font-sans font-bold uppercase text-[#64748B] tracking-wider block">
              📍 Registered Office
            </span>
            <div class="font-bold text-[#0F172A]">{SITE.legalName}</div>
            <p class="text-[#475569] leading-relaxed">
              {SITE.address.line1}<br />
              {SITE.address.line2}<br />
              {SITE.address.country}
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('audit-form');
  const successBox = document.getElementById('form-success');
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>
