---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PROCESS } from '@/lib/content';
---

<BaseLayout
  title="Operating Model & SLAs — How We Work | SIMBNEXT"
  description="From the initial briefing to the 4-stage rollout, weekly Monday briefings, and steady-state command center operations backed by our 90-Day Comfort Guarantee."
>
  <!-- Light Header Section -->
  <div class="pt-36 pb-20 bg-gradient-to-b from-[#EEF2FF] via-[#F8FAFC] to-white text-[#0F172A] border-b border-[#E2E8F0]">
    <div class="container-wide max-w-3xl space-y-4 text-center mx-auto">
      <span class="chip-synthesia">Operating Model & Method</span>
      <h1 class="headline-lg text-[#0F172A] [text-wrap:balance]">
        From Chaos to Command in Four Precise Stages
      </h1>
      <p class="body-lg text-[#334155] [text-wrap:balance]">
        A disciplined, senior-led operating flow: audit bottlenecks, architect your active desks, deploy in rapid sprints, and govern with weekly Monday briefings.
      </p>
    </div>
  </div>

  <div class="py-20 bg-[#FFFFFF]">
    <div class="container-wide max-w-4xl space-y-12">
      <!-- 4 Stages -->
      {PROCESS.map((p) => (
        <div class="card-synthesia p-8 grid gap-8 lg:grid-cols-[1.2fr_0.8fr] items-center">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <span class="text-3xl font-extrabold font-mono text-[#1B17FF]">
                {p.step}
              </span>
              <span class="chip-synthesia">Stage {p.step}</span>
            </div>
            <h2 class="headline-md text-[#0F172A]">
              {p.title}
            </h2>
            <p class="mt-3 text-sm text-[#64748B] leading-relaxed">
              {p.description}
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-[#F8FAFC] border border-[#E2E8F0]">
            <div class="label-sm text-[#64748B] mb-2.5">
              Stage Deliverables:
            </div>
            <ul class="space-y-2 text-xs font-semibold text-[#0F172A]">
              {p.deliverables.map((d) => (
                <li class="flex items-start gap-2">
                  <span class="text-[#1B17FF] font-bold">✓</span>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <!-- The 3 Pillars of Client Experience -->
      <div class="p-8 rounded-3xl bg-[#EEF2FF] border border-[#E0E7FF] space-y-6 shadow-xs">
        <span class="chip-synthesia">Client Experience</span>
        <h2 class="headline-md text-[#0F172A]">
          How You Experience the Command Center
        </h2>
        <div class="grid gap-4 sm:grid-cols-3 text-sm">
          <div class="p-5 rounded-2xl bg-white border border-[#E2E8F0] shadow-xs space-y-1.5">
            <div class="text-[#1B17FF] font-bold text-base">One Ops Lead</div>
            <div class="text-xs text-[#64748B] leading-relaxed">
              One senior point of contact who knows your entire account and answers every question.
            </div>
          </div>
          <div class="p-5 rounded-2xl bg-white border border-[#E2E8F0] shadow-xs space-y-1.5">
            <div class="text-[#1B17FF] font-bold text-base">Live Dashboard</div>
            <div class="text-xs text-[#64748B] leading-relaxed">
              Clear status visibility: On Track, Action Needed, and Delivered milestones across all desks.
            </div>
          </div>
          <div class="p-5 rounded-2xl bg-white border border-[#E2E8F0] shadow-xs space-y-1.5">
            <div class="text-[#1B17FF] font-bold text-base">Monday Briefings</div>
            <div class="text-xs text-[#64748B] leading-relaxed">
              A 15-minute async video and executive scorecard every Monday morning. Zero fluff.
            </div>
          </div>
        </div>
      </div>

      <!-- Action -->
      <div class="text-center pt-6">
        <a href="/briefing" class="button-primary">
          <span>Schedule a Briefing</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
