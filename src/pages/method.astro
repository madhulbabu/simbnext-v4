---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Method | SIMBNEXT"
  description="A systematic transition from your current state to complete operational peace."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#EEF2FF] via-[#F8FAFC] to-white text-[#0F172A] pt-36 md:pt-44 pb-20 md:pb-24 border-b border-[#E2E8F0]">
    <div class="container-wide text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-white text-[#1B17FF] border border-[#E0E7FF] shadow-xs">
        <span>How It Works</span>
      </div>

      <h1 class="headline-display text-[#0F172A] max-w-4xl mx-auto tracking-tight [text-wrap:balance]">
        Precision from day one.
      </h1>

      <p class="body-lg text-[#334155] max-w-2xl mx-auto leading-relaxed [text-wrap:balance]">
        A systematic transition from your current state to complete operational peace.
      </p>
    </div>
  </section>

  <!-- 4 Phases -->
  <section class="py-20 md:py-28 bg-white border-b border-[#E2E8F0]">
    <div class="container-tight space-y-8">
      
      <!-- Phase 1 -->
      <div id="phase-1" class="card-synthesia p-8 sm:p-10 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl text-white flex items-center justify-center font-bold font-mono shadow-md" style="background: linear-gradient(145deg, #38BDF8 0%, #1B17FF 48%, #120ECF 100%);">
            01
          </div>
          <span class="label-sm text-[#1B17FF]">Phase 01</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0F172A]">1. The Briefing</h2>
        <p class="text-base font-semibold text-[#1B17FF]">We listen before we act.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          A deep-dive session to understand your bottlenecks. We audit your existing tools, vendors, and processes.
        </p>
      </div>

      <!-- Phase 2 -->
      <div id="phase-2" class="card-synthesia p-8 sm:p-10 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl text-white flex items-center justify-center font-bold font-mono shadow-md" style="background: linear-gradient(145deg, #38BDF8 0%, #1B17FF 48%, #120ECF 100%);">
            02
          </div>
          <span class="label-sm text-[#1B17FF]">Phase 02</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0F172A]">2. The Blueprint</h2>
        <p class="text-base font-semibold text-[#1B17FF]">The architecture of your new operations.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          We present a comprehensive plan detailing what stays, what goes, and what we build. Nothing is left to chance.
        </p>
      </div>

      <!-- Phase 3 -->
      <div id="phase-3" class="card-synthesia p-8 sm:p-10 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl text-white flex items-center justify-center font-bold font-mono shadow-md" style="background: linear-gradient(145deg, #38BDF8 0%, #1B17FF 48%, #120ECF 100%);">
            03
          </div>
          <span class="label-sm text-[#1B17FF]">Phase 03</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0F172A]">3. The Sprint</h2>
        <p class="text-base font-semibold text-[#1B17FF]">Rapid deployment.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          We execute the blueprint. We migrate systems, build assets, and set up your Command Center dashboard.
        </p>
      </div>

      <!-- Phase 4 -->
      <div id="phase-4" class="card-synthesia p-8 sm:p-10 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl text-white flex items-center justify-center font-bold font-mono shadow-md" style="background: linear-gradient(145deg, #38BDF8 0%, #1B17FF 48%, #120ECF 100%);">
            04
          </div>
          <span class="label-sm text-[#1B17FF]">Phase 04</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0F172A]">4. The Command Center</h2>
        <p class="text-base font-semibold text-[#1B17FF]">Steady-state operations.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          We take over. You get a single Ops Lead, a live dashboard, and a concise Monday briefing. That's it.
        </p>
      </div>

    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 md:py-28 bg-[#0B0F19] text-white">
    <div class="container-tight text-center space-y-6">
      <h2 class="headline-lg text-white tracking-tight">
        See what operational peace feels like.
      </h2>
      <div class="pt-4">
        <a href="/briefing" class="button-primary bg-[#1B17FF] hover:bg-[#120ECF]">
          <span>Schedule a Briefing</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
