---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Philosophy | SIMBNEXT"
  description="The anti-agency. Why we built SIMBNEXT, and why the traditional model is obsolete."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#EFF6FF] via-[#F8FAFC] to-white text-[#0F172A] pt-36 md:pt-44 pb-20 md:pb-24 border-b border-[#E2E8F0]">
    <div class="container-wide text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-white text-[#1B17FF] border border-[#DBEAFE] shadow-xs">
        <span>Our Manifesto</span>
      </div>

      <h1 class="headline-display text-[#0F172A] max-w-4xl mx-auto tracking-tight [text-wrap:balance]">
        The anti-agency.
      </h1>

      <p class="body-lg text-[#334155] max-w-2xl mx-auto leading-relaxed [text-wrap:balance]">
        Why we built SIMBNEXT, and why the traditional model is obsolete.
      </p>
    </div>
  </section>

  <!-- Manifesto Sections -->
  <section class="py-20 md:py-28 bg-white border-b border-[#E2E8F0]">
    <div class="container-tight space-y-12">
      
      <!-- Section 1 -->
      <div class="card-synthesia p-8 sm:p-12 space-y-4">
        <span class="label-sm text-red-500">Principle 01</span>
        <h2 class="text-2xl sm:text-4xl font-bold text-[#0F172A]">Fragmentation is the enemy.</h2>
        <p class="text-lg font-semibold text-[#1B17FF]">Hiring specialists creates silos.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          You hire a dev shop, an SEO agency, and a branding freelancer. Suddenly, you aren't running a business — you're managing a messy committee.
        </p>
        <p class="text-base text-[#64748B] leading-relaxed">
          It drains your time and dilutes your brand.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="card-synthesia p-8 sm:p-12 space-y-4">
        <span class="label-sm text-[#1B17FF]">Principle 02</span>
        <h2 class="text-2xl sm:text-4xl font-bold text-[#0F172A]">We subtract complexity.</h2>
        <p class="text-lg font-semibold text-[#1B17FF]">You need a partner, not another vendor.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          SIMBNEXT was built to centralize accountability. When something breaks, you don't track down who is responsible.
        </p>
        <p class="text-lg font-bold text-[#0F172A]">
          We are.
        </p>
        <p class="text-base text-[#64748B] leading-relaxed">
          One point of contact. One unified standard of quality.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="card-synthesia p-8 sm:p-12 space-y-4">
        <span class="label-sm text-emerald-600">Principle 03</span>
        <h2 class="text-2xl sm:text-4xl font-bold text-[#0F172A]">Execution over noise.</h2>
        <p class="text-lg font-semibold text-[#1B17FF]">We don't do hype. We do the work.</p>
        <p class="text-base text-[#64748B] leading-relaxed">
          No jargon. No empty promises of overnight transformation. We promise operational peace of mind.
        </p>
        <p class="text-base text-[#64748B] leading-relaxed">
          Your business runs smoothly, efficiently, and quietly.
        </p>
      </div>

    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-20 md:py-28 bg-[#0B0F19] text-white">
    <div class="container-tight text-center space-y-6">
      <h2 class="headline-lg text-white tracking-tight [text-wrap:balance]">
        We built SIMBNEXT for business owners who are done managing chaos.
      </h2>
      <div class="pt-4">
        <a href="/briefing" class="button-primary bg-[#1B17FF] hover:bg-[#120ECF]">
          <span>Schedule a Briefing</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
